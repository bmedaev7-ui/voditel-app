module.exports = async (req, res) => {
  const allowedOrigin = "https://bmedaev7-ui.github.io";

  res.setHeader("Access-Control-Allow-Origin", allowedOrigin);
  res.setHeader("Access-Control-Allow-Methods", "POST, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");

  if (req.method === "OPTIONS") {
    return res.status(200).end();
  }

  if (req.method !== "POST") {
    return res.status(405).json({
      error: "Разрешён только POST-запрос"
    });
  }

  try {
    const key = process.env.DGIS_API_KEY;

    if (!key) {
      throw new Error("Ключ 2ГИС не найден в настройках Vercel");
    }

    const { from, to } = req.body || {};

    if (!from || !to) {
      return res.status(400).json({
        error: "Укажи адрес отправления и назначения"
      });
    }

    const headers = {
      Referer: "https://bmedaev7-ui.github.io/"
    };

    async function geocode(address) {
      const url = new URL(
        "https://catalog.api.2gis.com/3.0/items/geocode"
      );

      url.searchParams.set("q", address);
      url.searchParams.set("fields", "items.point");
      url.searchParams.set("locale", "ru_RU");
      url.searchParams.set("key", key);

      const response = await fetch(url, { headers });
      const data = await response.json();

      const point = data?.result?.items?.[0]?.point;

      if (!response.ok || !point) {
        throw new Error(
          "Не удалось определить координаты адреса: " + address
        );
      }

      return point;
    }

    const start = await geocode(from);
    const finish = await geocode(to);

    const routeUrl =
      "https://routing.api.2gis.com/routing/7.0.0/global?key=" +
      encodeURIComponent(key);

    const routeResponse = await fetch(routeUrl, {
      method: "POST",
      headers: {
        ...headers,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        points: [
          {
            type: "stop",
            lon: start.lon,
            lat: start.lat
          },
          {
            type: "stop",
            lon: finish.lon,
            lat: finish.lat
          }
        ],
        transport: "driving",
        output: "detailed",
        locale: "ru",
        route_mode: "fastest"
      })
    });

    const routeData = await routeResponse.json();
    const route = routeData?.result?.[0];

    if (!routeResponse.ok || !route ||
        !route.total_distance || !route.total_duration) {
      throw new Error("2ГИС не смог построить маршрут");
    }

    return res.status(200).json({
      distanceKm: Number(
        (route.total_distance / 1000).toFixed(2)
      ),
      durationMin: Math.ceil(route.total_duration / 60)
    });

  } catch (error) {
    return res.status(500).json({
      error: error.message || "Ошибка построения маршрута"
    });
  }
};
